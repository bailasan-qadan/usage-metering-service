# Database credentials. Docker Compose has local-demo defaults, so this file is optional.
POSTGRES_USER=metering
POSTGRES_PASSWORD=change_me
POSTGRES_DB=metering

# Used only when the service runs on your machine (npm run dev, npm test).
# Inside Docker Compose the service reaches the database by itself.
DATABASE_URL=postgres://metering:change_me@localhost:5433/metering

# Optional host ports for Docker Compose (defaults shown)
# SERVICE_PORT=3000
# CLIENT_PORT=4000
# DB_PORT=5433
