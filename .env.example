# Database credentials. These match the Docker Compose defaults, so this file is optional.
# Change the password for anything beyond a local demo (letters and digits only).
POSTGRES_USER=metering
POSTGRES_PASSWORD=metering
POSTGRES_DB=metering

# Used only when the service runs on your machine (npm run dev, npm test).
# Inside Docker Compose the service reaches the database by itself.
DATABASE_URL=postgres://metering:metering@localhost:5433/metering

# Optional host ports for Docker Compose (defaults shown)
# SERVICE_PORT=3000
# CLIENT_PORT=4000
# DB_PORT=5433
