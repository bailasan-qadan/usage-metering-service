Table plans {
  id uuid [pk]
  kind varchar [not null, note: 'account or user']
  name varchar [not null]
  monthly_allowance bigint [not null]
  max_per_request integer [not null]
  owner_account_id uuid [ref: > accounts.id, note: 'NULL = predefined, read-only']
  created_at timestamptz [not null]
}

Table accounts {
  id uuid [pk]
  name varchar [not null]
  plan_id uuid [not null, ref: > plans.id]
  created_at timestamptz [not null]
}

Table api_keys {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  key_hash varchar [not null, unique]
  created_at timestamptz [not null]
}

Table users {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  external_id varchar [not null]
  plan_id uuid [not null, ref: > plans.id]
  created_at timestamptz [not null]

  indexes {
    (account_id, external_id) [unique]
  }
}

Table account_usage {
  account_id uuid [not null, ref: > accounts.id]
  month date [not null, note: 'first day of the UTC month']
  units_used bigint [not null]

  indexes {
    (account_id, month) [pk]
  }
}

Table user_usage {
  user_id uuid [not null, ref: > users.id]
  month date [not null]
  units_used bigint [not null]

  indexes {
    (user_id, month) [pk]
  }
}

Table consumption_requests {
  id uuid [pk]
  account_id uuid [not null, ref: > accounts.id]
  user_id uuid [not null, ref: > users.id]
  request_id varchar [not null, note: 'supplied by the caller']
  units integer [not null]
  month date [not null]
  accepted boolean [not null]
  rejected_level varchar [note: 'account or user, NULL if accepted']
  rejected_rule varchar [note: 'monthly_allowance or max_per_request']
  created_at timestamptz [not null]

  indexes {
    (account_id, request_id) [unique]
  }
}
